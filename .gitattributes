# Reproducible builds: keep every text file LF in the repository and in the working tree,
# so the compiler sees identical bytes regardless of where the tree is checked out.
* text=auto eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.dwg binary
*.dxf binary
*.dll binary
*.png binary